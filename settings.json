// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "cli_default_open_behavior": "new_window",
    "git": {
        "blame": {
            "show_avatar": true,
        },
        "disable_git": false,
    },
    "project_panel": {
        "dock": "right",
        "hide_gitignore": true,
    },
    "outline_panel": {
        "dock": "right",
    },
    "collaboration_panel": {
        "dock": "right",
    },
    "git_panel": {
        "dock": "right",
        "tree_view": true,
    },
    "terminal": {
        "copy_on_select": true,
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "icon_theme": {
        "mode": "light",
        "light": "Material Icon Theme",
        "dark": "Material Icon Theme",
    },
    "session": {
        "trust_all_worktrees": true,
    },
    "vim_mode": true,
    "theme": {
        "mode": "dark",
        "light": "Catppuccin Latte - No Italics",
        "dark": "Tokyo Night",
    },
    "wrap_guides": [80],
    "buffer_font_fallbacks": ["Segoe UI"],
    "ui_font_family": "Fira Code",
    "ui_font_size": 16,
    "buffer_font_family": "Fira Code",
    "buffer_font_size": 16,
    "base_keymap": "VSCode",
    "autosave": {
        "after_delay": {
            "milliseconds": 5000,
        },
    },
    "tab_size": 4,
    "hard_tabs": false,

    "auto_indent_on_paste": true,

    "inlay_hints": {
        "show_value_hints": true,
    },
    "gutter": {
        "folds": false,
        "runnables": false, // Hides run/debug icons
        "line_numbers": true,
    },

    "edit_predictions": {
        "provider": "open_ai_compatible_api",
        "open_ai_compatible_api": {
            "api_url": "http://localhost:1234/v1/completions",
            "model": "qwen2.5-coder-1.5b-instruct",
            "prompt_format": "qwen",
            "max_output_tokens": 512,
        },
        "mode": "eager",
    },

    "language_models": {
        "openai_compatible": {
            "Together.ai": {
                "api_url": "https://api.together.xyz/v1",
                "available_models": [
                    {
                        "name": "Qwen/Qwen3.5-397B-A17B",
                        "max_tokens": 64000,
                        "max_output_tokens": 32768,
                        "max_completion_tokens": 50000,
                        "capabilities": {
                            "tools": true,
                            "images": false,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false,
                            "chat_completions": true,
                        },
                    },
                    {
                        "name": "moonshotai/Kimi-K2.5",
                        "max_tokens": 64000,
                        "max_output_tokens": 32768,
                        "max_completion_tokens": 60000,
                        "capabilities": {
                            "tools": true,
                            "images": false,
                            "parallel_tool_calls": true,
                            "prompt_cache_key": false,
                            "chat_completions": true,
                        },
                    },
                ],
            },

            "ollama": {
                "api_url": "http://localhost:11434/v1",
                "available_models": [
                    {
                        "name": "qwen3.6:27b",
                        "display_name": "Qwen 3.6 27B (Local)",
                        "max_tokens": 32768,
                        "max_output_tokens": 32768,
                    },
                    {
                        "name": "gemma4:26b",
                        "display_name": "Gemma4 26B (Local)",
                        "max_tokens": 32768,
                        "max_output_tokens": 32768,
                    },
                    {
                        "name": "gemma4:31b",
                        "display_name": "Gemma4 31B (Local)",
                        "max_tokens": 32768,
                        "max_output_tokens": 32768,
                    },
                ],
            },

            "LMStudio": {
                "api_url": "http://localhost:1234/v1",
                "available_models": [
                    {
                        "name": "mlx-community/qwen3.6-35b-a3b",
                        "display_name": "MLX Qwen 3.6 35B-A3B (Local)",
                        "max_tokens": 32768,
                        "max_output_tokens": 32768,
                    },
                    {
                        "name": "mlx-community/qwen3.6-27b",
                        "display_name": "MLX Qwen 3.6 27B (Local)",
                        "max_tokens": 32768,
                        "max_output_tokens": 32768,
                    },
                    {
                        "name": "qwen/qwen3-coder-30b",
                        "display_name": "Qwen 3 Coder 30B (Local)",
                        "max_tokens": 32768,
                        "max_output_tokens": 32768,
                    },
                    {
                        "name": "qwen/qwen3.6-35b-a3b",
                        "display_name": "Qwen 3.6 35B-A3B (Local)",
                        "max_tokens": 32768,
                        "max_output_tokens": 32768,
                    },
                    {
                        "name": "qwen/qwen3.6-27b",
                        "display_name": "Qwen3.6 27B (Local)",
                        "max_tokens": 32768,
                        "max_output_tokens": 32768,
                    },
                    {
                        "name": "google/gemma-4-31b",
                        "display_name": "Gemma4 31B (Local)",
                        "max_tokens": 32768,
                        "max_output_tokens": 32768,
                    },
                    {
                        "name": "google/gemma-4-26b-a4b",
                        "display_name": "Gemma4 26B-A4B (Local)",
                        "max_tokens": 32768,
                        "max_output_tokens": 32768,
                    },
                ],
            },
        },
    },

    "context_servers": {
        "mcp-server-context7": {
            "enabled": true,
            "remote": false,
            "settings": {
                "context7_api_key": "",
            },
        },
    },

    "agent": {
        "dock": "left",

        "commit_message_model": {
            "provider": "openai_compatible/LMStudio",
            "model": "qwen2.5-coder-1.5b-instruct",
            "enable_thinking": true,
        },

        "inline_assistant_model": {
            "provider": "lmstudio",
            "model": "qwen2.5-coder-3b-instruct",
            "enable_thinking": false,
        },

        "profiles": {
            "write": {
                "name": "Write",
                "tools": {},
                "enable_all_context_servers": false,
                "context_servers": {},
            },
        },

        "tool_permissions": {
            "tools": {
                "create_directory": {
                    "default": "allow",
                },
                "edit_file": {
                    "default": "allow",
                },
                "terminal": {
                    "default": "allow",
                    "always_allow": [
                        {
                            "pattern": "^pixi\\s+run(\\s|$)",
                        },
                        {
                            "pattern": "^tail\\b",
                        },
                        {
                            "pattern": "^grep\\b",
                        },
                        {
                            "pattern": "^pixi\\s+init(\\s|$)",
                        },
                        {
                            "pattern": "^pixi\\s+add(\\s|$)",
                        },
                        {
                            "pattern": "^pixi\\s+list(\\s|$)",
                        },
                    ],
                },
            },
        },

        "default_model": {
            "provider": "lmstudio",
            "model": "mlx-community/qwen3.6-35b-a3b",
            "enable_thinking": true,
        },

        "inline_alternatives": [
            {
                "provider": "ollama",
                "model": "qwen3.6:35b-a3b-coding-mxfp8",
            },
            {
                "provider": "ollama",
                "model": "qwen3.6:35b-a3b-coding-nvfp4",
            },
            {
                "provider": "zed.dev",
                "model": "gpt-4-mini",
            },
        ],

        "favorite_models": [
            {
                "provider": "ollama",
                "model": "qwen3.6:35b-a3b-coding-mxfp8",
                "enable_thinking": false,
            },
        ],

        "model_parameters": [],
    },

    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },

        "kilo": {
            "favorite_config_option_values": {
                "model": [
                    "ollama/qwen3.5:35b-a3b-coding-nvfp4",
                    "ollama/qwen3.6:35b-a3b-coding-mxfp8",
                ],
            },
            "favorite_models": ["ollama/qwen3.6:35b-a3b-coding-mxfp8"],
            "type": "registry",
        },

        "opencode": {
            "favorite_config_option_values": {
                "model": [
                    "ollama/qwen3.6:35b-a3b-coding-mxfp8",
                    "ollama/qwen3.6:35b-a3b-coding-nvfp4",
                    "lmstudio/mlx-community/qwen3.6-35b-a3b",
                    "lmstudio/mlx-community/qwen3.6-27b",
                    "lmstudio/qwen/qwen3.6-35b-a3b",
                    "lmstudio/qwen/qwen3.6-27b"
                ],
            },
            "type": "registry",
        },
    },

    "languages": {
        "Python": {
            "soft_wrap": "prefer_line",
            "allow_rewrap": "in_comments",
            "preferred_line_length": 80,
            "inlay_hints": {
                "enabled": false,
            },
            "language_servers": ["ruff", "pyright"],
            "format_on_save": "on",
            "code_actions_on_format": {
                "source.fixAll.ruff": true,
                "source.organizeImports.ruff": true,
            },
            "formatter": {
                "language_server": {
                    "name": "ruff",
                },
            },
        },
    },

    "show_completions_on_input": false, // disables LSP completion in facor of AI edit predictions
    "lsp": {
        "ruff": {
            "initialization_options": {
                "settings": {
                    "lineLength": 80,

                    "lint": {
                        "extendSelect": ["I", "W505"],
                        "pycodestyle": {
                            "maxDocLength": 72,
                        },
                    },
                },
            },
        },
    },
}
